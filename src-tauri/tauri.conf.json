{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ddumba Property Operations OS",
  "version": "0.1.0",
  "identifier": "com.ddumba.property-operations-os",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build && npm run desktop:prepare",
    "frontendDist": "../desktop-dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ddumba Property Operations OS",
        "width": 1440,
        "height": 950,
        "minWidth": 1180,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg"],
    "publisher": "Ddumba Property Operations",
    "category": "Business",
    "shortDescription": "Offline-first desktop edition of Ddumba Property Operations OS.",
    "longDescription": "Ddumba Property Operations OS desktop application with offline workspace support and secure synchronization to the production Ddumba OS backend.",
    "icon": ["icons/icon.icns", "icons/icon.ico"]
  }
}
